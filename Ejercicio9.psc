Algoritmo Ejercicio9
	//Angela Orcera Ruiz 1ºDAW
	//Hago las tablas del 1 al 5
	//Datos de entrada
	//Pongo un Para dentro de otro para hacer las tablas
	Definir numero, i Como Entero
	Para numero <- 1 Hasta 5 Hacer
	    Para i <- 1 Hasta 10 Hacer
	        Escribir numero, " x ", i, " = ", numero*i
	    FinPara
	FinPara
FinAlgoritmo
