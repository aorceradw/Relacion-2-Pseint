Algoritmo Ejercicio12
	//Angela Orcera Ruiz 1ºDAW
	//Muestro las horas, minutos y segundos del cronometro
	//Datos de entrada
	//Los bucles estan anidados porque cambian horas, minutos y segundos
	Definir hora, minuto, segundo Como Entero
	Para hora <- 0 Hasta 23 Hacer
	    Para minuto <- 0 Hasta 59 Hacer
	        Para segundo <- 0 Hasta 59 Hacer
	            Escribir hora, ":", minuto, ":", segundo
	        FinPara
	    FinPara
	FinPara
FinAlgoritmo
