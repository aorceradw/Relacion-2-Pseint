Algoritmo Ejercicio6
	//Angela Orcera Ruiz 1ºDAW
	//Hago la tabla de multiplicar
	//Datos de entrada
	//Uso Para porque se que son diez vueltas
	Definir numero, i Como Entero
	//Pido por teclado
	Leer numero
	Para i <- 1 Hasta 10 Hacer
	    Escribir numero, " x ", i, " = ", numero*i
	FinPara
FinAlgoritmo
